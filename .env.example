# Vault Configuration
# Copy this file to .env and fill in the values

# ===================
# Vault Settings
# ===================
VAULT_ADDR=http://127.0.0.1:8200
VAULT_API_ADDR=                    # External IP for API (auto-detected if empty)
VAULT_VERSION=1.20.4
VAULT_PORT=8200
VAULT_CLUSTER_PORT=8201
VAULT_NODE_ID=vault-node-1
VAULT_DATA_DIR=/var/lib/vault
VAULT_CONFIG_DIR=/etc/vault.d
VAULT_LOG_DIR=/var/log/vault
VAULT_TLS_DIR=/opt/vault/tls

# Unseal Configuration
VAULT_UNSEAL_SHARES=5
VAULT_UNSEAL_THRESHOLD=3

# Root Token (set after initialization)
VAULT_TOKEN=

# ===================
# MinIO Backup Settings
# ===================
MINIO_ENDPOINT=https://minio.example.com:9443
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vault-backups
MINIO_ALIAS=minio

# ===================
# Backup Settings
# ===================
BACKUP_DIR=/tmp/vault-backups
BACKUP_RETENTION_DAYS=30

# ===================
# Keys Directory
# ===================
VAULT_KEYS_DIR=./vault-boot
